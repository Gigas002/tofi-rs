# Complete tofi configuration — every supported key set explicitly.
# This file documents all options and serves as a parse-completeness fixture.
# Values are intentionally non-default so tests can verify each key was applied.

### Window geometry
anchor = top-left
exclusive-zone = 0
output = ""
width = 800
height = 600
margin-top = 10
margin-bottom = 20
margin-left = 30
margin-right = 40
scale = false

### Font
font = "Monospace"
font-size = 16
font-features = "liga 0"
font-variations = "wght 700"
hint-font = false

### Window colors / decoration
background-color = #1a1a2eff
text-color = #cdd6f4ff
border-color = #89b4faff
outline-color = #313244ff
selection-match-color = #f38ba8ff
corner-radius = 8
border-width = 3
outline-width = 2

### Padding
padding-top = 12
padding-bottom = 14
padding-left = 16
padding-right = 18
clip-to-padding = false

### Text layout
prompt-text = "> "
prompt-padding = 4
placeholder-text = "type to search..."
num-results = 10
result-spacing = 2
horizontal = true
min-input-width = 200

### Text cursor
text-cursor = true
text-cursor-style = block
text-cursor-color = #cdd6f4ff
text-cursor-background = #1e1e2eff
text-cursor-corner-radius = 2
text-cursor-thickness = 3

### Prompt theme
prompt-color = #cba6f7ff
prompt-background = #313244ff
prompt-background-padding = 4,8
prompt-background-corner-radius = 4

### Input theme
input-color = #cdd6f4ff
input-background = #1e1e2eff
input-background-padding = 4,8
input-background-corner-radius = 4

### Placeholder theme
placeholder-color = #6c7086ff
placeholder-background = #1e1e2eff
placeholder-background-padding = 4,8
placeholder-background-corner-radius = 4

### Default result theme
default-result-color = #cdd6f4ff
default-result-background = #1e1e2eff
default-result-background-padding = 2,8
default-result-background-corner-radius = 4

### Alternate result theme
alternate-result-color = #a6adc8ff
alternate-result-background = #181825ff
alternate-result-background-padding = 2,8
alternate-result-background-corner-radius = 4

### Selection theme
selection-color = #1e1e2eff
selection-background = #cba6f7ff
selection-background-padding = 2,8
selection-background-corner-radius = 4

### Behaviour
hide-cursor = true
history = false
history-file = /tmp/tofi-test-history
matching-algorithm = fuzzy
require-match = false
auto-accept-single = true
print-index = true
hide-input = false
hidden-character = "*"
physical-keybindings = false
drun-launch = false
terminal = alacritty
late-keyboard-init = true
multi-instance = true
ascii-input = true
